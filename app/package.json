{
  "name": "codenost",
  "version": "0.1.0",
  "private": true,
  "description": "CodeNost desktop IDE",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/project-service.js && node --check electron/supabase-service.js && node --check src/js/ai.js && node --check src/js/app.js && node --check src/js/editor.js && node --check src/js/projects.js && node --check src/js/extensions.js && node --check src/js/ui.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.codenost.desktop",
    "productName": "CodeNost",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "protocols": [
      {
        "name": "CodeNost",
        "schemes": [
          "codenost"
        ]
      }
    ]
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@supabase/supabase-js": "^2.57.4",
    "node-pty": "^1.0.0"
  }
}
